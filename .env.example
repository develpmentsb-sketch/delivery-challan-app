# Supabase project credentials (safe for frontend: anon/public key only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Company details used on printed Delivery Challan / PDF header
VITE_COMPANY_NAME="Your Company Pvt. Ltd."
VITE_COMPANY_GSTIN=29ABCDE1234F1Z5
VITE_COMPANY_ADDRESS="123, Industrial Layout, Bengaluru"
VITE_COMPANY_STATE=Karnataka
VITE_COMPANY_STATE_CODE=29
VITE_COMPANY_PINCODE=560001
VITE_COMPANY_PHONE=+91-9876543210
VITE_COMPANY_EMAIL=accounts@yourcompany.com
VITE_COMPANY_LOGO_URL=

# NOTE: Do NOT put any GST/E-Way Bill government API key or Supabase
# service-role key here. Those belong only on a secure backend
# (e.g. a Supabase Edge Function) and must never ship to the browser.
